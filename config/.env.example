# NVIDIA API (gratis en build.nvidia.com)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxx

# Pexels API (gratis en pexels.com/api)
PEXELS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# YouTube OAuth credentials (descargado desde Google Cloud Console)
YOUTUBE_CREDENTIALS=config/client_secrets.json

# ── Pipeline Experimental V2 (Gemini) ──────────────────────────────────────
# Google Gemini API Key (gratis en aistudio.google.com/apikey)
GEMINI_API_KEY=AIzaSy-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo Gemini a usar (verificar disponibilidad en /api/v2/modelos)
# Opciones: gemini-2.5-flash, gemini-3.5-flash, gemini-2.0-flash, etc.
GEMINI_MODEL=gemini-2.5-flash

# Modelo para generación de imágenes (verificar disponibilidad en /api/v2/modelos)
# Imagen 3 se intenta primero automáticamente. Este es el fallback si no está disponible.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ── Hooks opcionales para bajar costos a ~$0 ──────────────────────────────
# XTTS v2 local — TTS de alta calidad sin costo
# Arrancar con: tts-server --model_name tts_models/multilingual/multi-dataset/xtts_v2 --port 8020
# TTS_LOCAL_URL=http://localhost:8020

# GPU propia para imágenes (RunPod/Vast.ai con Flux o SD 3.5)
# ~$0.003/imagen → $0.54 para 180 escenas de 15 min
# GPU_API_URL=https://tu-instancia.runpod.io/generate
